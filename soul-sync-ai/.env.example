# SoulSync AI Environment Configuration
# Copy this file to '.env' and fill in your keys

# 1. Supabase Backend Connection Details
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here

# 2. Google Gemini API Connection Details
EXPO_PUBLIC_GEMINI_API_KEY=your_gemini_api_key_here
